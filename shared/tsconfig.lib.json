{
  // shared/ is used by both the server and the browser, so it may depend on neither:
  // no DOM or Node types, and no imports from server/ or client/.
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "types": [],
    // Only written by `tsc -b`; kept out of the repo
    "tsBuildInfoFile": "../node_modules/.tmp/tsconfig.shared-lib.tsbuildinfo"
  },
  "include": ["*.ts"],
  "exclude": ["*.test.ts"]
}

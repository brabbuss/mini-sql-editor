{
  // The client's tests run in Node (node:test), so they get Node's types; browser code doesn't.
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "types": ["vite/client", "node"],
    "tsBuildInfoFile": "../node_modules/.tmp/tsconfig.test.tsbuildinfo"
  },
  "include": ["src/**/*.test.ts", "src/**/*.test.tsx", "src/testSetup.ts"],
  "exclude": []
}
